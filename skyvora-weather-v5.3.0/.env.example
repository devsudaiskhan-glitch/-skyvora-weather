NODE_ENV=development
PORT=5065
TRUST_PROXY=false
MONGODB_URI=
MONGODB_CONNECT_TIMEOUT_MS=8000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100
# Optional Open-Meteo commercial endpoint settings. Leave defaults for approved non-commercial evaluation.
OPEN_METEO_FORECAST_BASE=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_BASE=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_AIR_QUALITY_BASE=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_ARCHIVE_BASE=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_MARINE_BASE=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_CUSTOMER_API_KEY=
OPEN_METEO_COMMERCIAL=false
# Add an AI provider only after implementing and validating its backend adapter.
AI_PROVIDER=
AI_API_KEY=
